# Copy to .streamlit/secrets.toml for local use. Never commit real values.

DATABASE_URL = "sqlite+pysqlite:///database/poli-insight.sqlite"
APP_TIMEZONE = "America/Los_Angeles"

# For local development only, set both:
#   POLI_INSIGHT_ENVIRONMENT=development
#   POLI_INSIGHT_AUTH_BACKEND=development
# Then uncomment this top-level key in your untracked secrets.toml:
# DEV_ADMIN_PASSWORD = "replace-with-a-local-password"

# Streamlit OIDC configuration used by the streamlit_oidc backend.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-provider-client-id"
client_secret = "replace-with-provider-client-secret"
server_metadata_url = "https://provider.example/.well-known/openid-configuration"
