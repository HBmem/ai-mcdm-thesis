DATABASE_URL=sqlite+pysqlite:///database/poli-insight.sqlite
APP_TIMEZONE=America/Los_Angeles
PUBLIC_BASE_URL=http://localhost:8501
SCENARIO_SOURCE_ROOT=scenarios
SCENARIO_TEMPLATE_DIRECTORY=_template
APP_ENV=development
# Production deployments should use POLI_INSIGHT_ENVIRONMENT=production and
# an HTTPS PUBLIC_BASE_URL such as https://research.example.edu/poli-insight.
POLI_INSIGHT_ENVIRONMENT=development
# Keyed lookup protection for sensitive external participant references.
# Use independent, randomly generated values of at least 32 bytes in production.
PARTICIPANT_IMPORT_HMAC_SECRET=development-only-participant-import-secret-change-me
PARTICIPANT_IDENTITY_ENCRYPTION_KEY=development-only-participant-identity-key-change-me
IMPORTED_IDENTITY_RETENTION_DAYS=365
PARTICIPANT_IMPORT_MAX_BYTES=10485760
PARTICIPANT_IMPORT_MAX_ROWS=5000
